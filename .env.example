# ------------------------------------------------------------------
# AI 블로그 콘텐츠 제작 — 환경변수
#
# 로컬에서는 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
#   cp .env.example .env.local
#
# .env.local 은 .gitignore 에 걸려 있으므로 커밋되지 않는다.
# 이 파일(.env.example)에는 절대 실제 키를 적지 말 것.
# ------------------------------------------------------------------

# 원고 생성기 제공자 — claude | mock
#   claude : 실제 Anthropic API 호출 (ANTHROPIC_API_KEY 필요)
#   mock   : API 없이 템플릿 기반 데모 생성 (오프라인 개발·장애 대응용)
#
# claude 로 두고 API Key 가 없으면 "자동으로 mock 으로 넘어가지 않고"
# 명확한 설정 오류를 돌려준다. 의도한 동작이므로 상태를 헷갈릴 일이 없다.
AI_BLOG_PROVIDER=claude

# Anthropic API Key — 서버에서만 사용한다.
# NEXT_PUBLIC_ 접두사를 붙이면 브라우저 번들에 들어가므로 절대 금지.
ANTHROPIC_API_KEY=

# 사용할 모델 (미설정 시 claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# 추론 강도 — low | medium | high | xhigh | max (미설정 시 API 기본값 high)
# 응답이 느려 라우트 제한시간에 걸리면 medium 또는 low 로 낮춘다.
# AI_BLOG_EFFORT=medium

# 계정당 분당 최대 생성/수정 호출 수 (미설정 시 10)
# AI_BLOG_RATE_LIMIT_PER_MINUTE=10

# 이미지 생성 Provider — mock | real
#   mock : 이미지 API 없이 코드로 그린 벡터 아트(일러스트·아이콘·도형)로 렌더링
#   real : 이미지 생성 API 로 "글자 없는 그래픽"을 받아 배경으로 깔고,
#          한글 텍스트는 웹 렌더러가 그 위에 합성한다.
#          AI_IMAGE_API_URL 이 없으면 명확한 설정 오류를 돌려준다.
AI_IMAGE_PROVIDER=mock

# real provider 를 쓸 때 호출할 이미지 생성 엔드포인트
#   POST { prompt, width, height, format } → { url }
#   그래픽만 생성하고 한글 텍스트는 웹에서 합성한다.
# AI_IMAGE_API_URL=
# AI_IMAGE_API_KEY=
